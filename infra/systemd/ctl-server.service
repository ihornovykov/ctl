[Unit]
Description=ctl Fastify API server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/ctl/current/apps/server

# Env file written by CI — never commit real secrets
EnvironmentFile=/etc/ctl/server.env

# Tells Fastify (via @fastify/request-context) and Better Auth to trust
# the X-Forwarded-Proto header set by nginx
Environment=TRUST_PROXY=1

ExecStart=/usr/bin/node dist/index.mjs
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ctl-server

# Allow Docker socket access (deploy is in the docker group)
SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target
