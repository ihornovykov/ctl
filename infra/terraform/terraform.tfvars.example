# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it is gitignored.

# DigitalOcean personal access token.
# Create at: https://cloud.digitalocean.com/account/api/tokens
do_token = "dop_v1_REPLACE"

# Numeric Droplet ID. Get with:
#   doctl compute droplet list
droplet_id = "REPLACE"

# These defaults match the Droplet created in the handoff.
# Only change if your Droplet differs.
droplet_name   = "code-to-learn"
droplet_region = "fra1"
droplet_size   = "s-1vcpu-2gb"
droplet_image  = "ubuntu-24-04-x64"
